rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    function orgMatch(orgId) {
      return isAuth() && resource.data.organizationId == orgId;
    }
    function orgCreateMatch(orgId) {
      return isAuth() && request.resource.data.organizationId == orgId;
    }

    function isOrgOwner(orgId) {
      return isAuth() && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    // BUILD-031A / RBAC-001 — Outer boundary + membership-aware checks.
    // Path-based member index: organizations/{orgId}/members/{userId}
    // (synced on org create + invitation accept). Full permission matrix
    // remains in Authorization Service; rules stop privilege escalation.

    function isOrgMember(orgId) {
      return isAuth()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // Atomic onboarding may create the member index and related records in one batch.
    function isOrgMemberAfter(orgId) {
      return isAuth()
        && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.userId == request.auth.uid;
    }

    function hasOrgAccessAfter(orgId) {
      return isOrgOwner(orgId) || isOrgMember(orgId) || isOrgMemberAfter(orgId);
    }

    function hasOrgAccess(orgId) {
      return isOrgOwner(orgId) || isOrgMember(orgId);
    }

    function releaseTrackCanRead() {
      return resource.data.organizationId is string
        && hasOrgAccess(resource.data.organizationId);
    }

    function releaseTrackCanWriteAfter() {
      return request.resource.data.organizationId is string
        && request.resource.data.releaseId is string
        && request.resource.data.trackId is string
        && existsAfter(/databases/$(database)/documents/releases/$(request.resource.data.releaseId))
        && existsAfter(/databases/$(database)/documents/tracks/$(request.resource.data.trackId))
        && getAfter(/databases/$(database)/documents/releases/$(request.resource.data.releaseId)).data.organizationId is string
        && getAfter(/databases/$(database)/documents/tracks/$(request.resource.data.trackId)).data.organizationId
          == getAfter(/databases/$(database)/documents/releases/$(request.resource.data.releaseId)).data.organizationId
        && request.resource.data.organizationId == getAfter(/databases/$(database)/documents/releases/$(request.resource.data.releaseId)).data.organizationId
        && hasOrgAccess(request.resource.data.organizationId);
    }

    function organizationArtistExists(orgId, artistId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/artists/$(artistId));
    }

    function organizationArtistExistsAfter(orgId, artistId) {
      return existsAfter(/databases/$(database)/documents/organizations/$(orgId)/artists/$(artistId));
    }

    function trackArtistCanRead() {
      // Reads are tenant-scoped by organizationId. Do not depend on artistId
      // here: valid queries by trackId/role do not constrain artistId, and
      // Firestore Rules must be able to prove the query safe for all results.
      // Same-tenant track/artist referential integrity is enforced on writes
      // and by the catalogue-link migration gate.
      return resource.data.organizationId is string
        && hasOrgAccess(resource.data.organizationId);
    }

    function trackArtistCanWriteAfter() {
      return request.resource.data.organizationId is string
        && request.resource.data.trackId is string
        && request.resource.data.artistId is string
        && existsAfter(/databases/$(database)/documents/tracks/$(request.resource.data.trackId))
        && getAfter(/databases/$(database)/documents/tracks/$(request.resource.data.trackId)).data.organizationId == request.resource.data.organizationId
        && organizationArtistExistsAfter(request.resource.data.organizationId, request.resource.data.artistId)
        && hasOrgAccess(request.resource.data.organizationId);
    }

    function trackArtistCanWriteExisting() {
      return resource.data.organizationId is string
        && resource.data.trackId is string
        && resource.data.artistId is string
        && exists(/databases/$(database)/documents/tracks/$(resource.data.trackId))
        && get(/databases/$(database)/documents/tracks/$(resource.data.trackId)).data.organizationId == resource.data.organizationId
        && organizationArtistExists(resource.data.organizationId, resource.data.artistId)
        && hasOrgAccess(resource.data.organizationId);
    }

    function memberRole(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.roleId;
    }

    function isManagerOrAbove(orgId) {
      return isAuth() && (
        isOrgOwner(orgId)
        || (
          isOrgMember(orgId) && memberRole(orgId) in [
            'owner', 'administrator', 'admin', 'project_manager', 'release_manager'
          ]
        )
      );
    }

    function isAdminOrAbove(orgId) {
      return isAuth() && (
        isOrgOwner(orgId)
        || (
          isOrgMember(orgId) && memberRole(orgId) in [
            'owner', 'administrator', 'admin'
          ]
        )
      );
    }

    // Invitation acceptance is the only non-owner path that may create a
    // membership. The invitation must be accepted in the same atomic write,
    // belong to this organization, target the authenticated email, and map to
    // the exact canonical role assigned by the invitation contract.
    function invitationRoleMatches(roleId, invitation) {
      return (
        invitation.platformRole == 'administrator' && roleId == 'administrator'
      ) || (
        invitation.platformRole == 'release_manager' && roleId == 'release_manager'
      ) || (
        invitation.platformRole == 'collaborator' && roleId == 'contributor'
      );
    }

    function hasValidAcceptedInvitation(orgId, roleId) {
      return isAuth()
        && request.auth.token.email is string
        && request.resource.data.invitationToken is string
        && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationToken)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationToken)).data.organizationId == orgId
        && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationToken)).data.inviteeEmail == request.auth.token.email
        && invitationRoleMatches(
          roleId,
          getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationToken)).data
        );
    }

    // Organization management stays owner-only (organization.manage).
    match /organizations/{orgId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOrgOwner(orgId);
    }
    match /organizations/{orgId}/artists/{artistId} {
      allow read: if isOrgMember(orgId) || isAuth();
      allow write: if isManagerOrAbove(orgId);
    }
    // Member index used by rules — users may write own active membership (invite accept);
    // role elevation only by org owner/admin.
    match /organizations/{orgId}/members/{memberId} {
      allow read: if isAuth() && (request.auth.uid == memberId || isOrgMember(orgId));
      allow create: if isAuth()
        && request.auth.uid == memberId
        && request.resource.data.userId == request.auth.uid
        && (
          (
            isOrgOwner(orgId)
            && request.resource.data.roleId == 'owner'
          )
          || hasValidAcceptedInvitation(orgId, request.resource.data.roleId)
        );
      allow update: if isAuth() && (
        isOrgOwner(orgId)
        || isAdminOrAbove(orgId)
        || (
          request.auth.uid == memberId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.roleId == resource.data.roleId
          && request.resource.data.status == resource.data.status
        )
        || (
          request.auth.uid == memberId
          && request.resource.data.userId == request.auth.uid
          && hasValidAcceptedInvitation(orgId, request.resource.data.roleId)
        )
      );
      allow delete: if isOrgOwner(orgId) || isAdminOrAbove(orgId);
    }

    // Media subsystem — organization-scoped subcollections (multi-tenant).
    // Tenant isolation is enforced by the path ({orgId}); rules only gate on
    // authentication. Per-role permissions (upload/replace/delete/approve)
    // are enforced server-side; do not encode them here.
    function mediaGuard(orgId) {
      return isAuth();
    }
    match /organizations/{orgId}/media_assets/{assetId}     { allow read,list: if mediaGuard(orgId); allow create: if mediaGuard(orgId) && orgCreateMatch(orgId); allow update,delete: if mediaGuard(orgId); }
    match /organizations/{orgId}/media_versions/{versionId} { allow read,list: if mediaGuard(orgId); allow create: if mediaGuard(orgId) && orgCreateMatch(orgId); allow update,delete: if mediaGuard(orgId); }
    match /organizations/{orgId}/media_usage/{usageId}      { allow read,list: if mediaGuard(orgId); allow create: if mediaGuard(orgId) && orgCreateMatch(orgId); allow update,delete: if mediaGuard(orgId); }
    match /organizations/{orgId}/media_reviews/{reviewId}   { allow read,list: if mediaGuard(orgId); allow create: if mediaGuard(orgId) && orgCreateMatch(orgId); allow update,delete: if mediaGuard(orgId); }
    match /organizations/{orgId}/media_comments/{commentId} { allow read,list: if mediaGuard(orgId); allow create: if mediaGuard(orgId) && orgCreateMatch(orgId); allow update,delete: if mediaGuard(orgId); }
    match /organizations/{orgId}/artworks/{artworkId}     { allow read,list: if mediaGuard(orgId); allow create: if mediaGuard(orgId) && orgCreateMatch(orgId); allow update,delete: if mediaGuard(orgId); }
    // BUILD-301D — storage locations (org-scoped configuration; no secrets in docs)
    match /organizations/{orgId}/storage_locations/{locationId} {
      allow read, list: if isAuth() && isOrgMember(orgId);
      allow create: if isAuth() && isOrgMember(orgId) && orgCreateMatch(orgId)
        && request.resource.data.organizationId == orgId;
      allow update, delete: if isAuth() && isOrgMember(orgId)
        && resource.data.organizationId == orgId;
    }
    // BUILD-301E — storage policies (org-scoped routing config; no secrets)
    match /organizations/{orgId}/storage_policies/{policyId} {
      allow read, list: if isAuth() && isOrgMember(orgId);
      allow create: if isAuth() && isOrgMember(orgId) && orgCreateMatch(orgId)
        && request.resource.data.organizationId == orgId;
      allow update, delete: if isAuth() && isOrgMember(orgId)
        && resource.data.organizationId == orgId;
    }
    // BUILD-301E — folder templates (org-scoped logical paths; no provider paths)
    match /organizations/{orgId}/folder_templates/{templateId} {
      allow read, list: if isAuth() && isOrgMember(orgId);
      allow create: if isAuth() && isOrgMember(orgId) && orgCreateMatch(orgId)
        && request.resource.data.organizationId == orgId;
      allow update, delete: if isAuth() && isOrgMember(orgId)
        && resource.data.organizationId == orgId;
    }
    // BUILD-301F — durable storage references (org-scoped; no secrets / no downloadUrl identity)
    match /organizations/{orgId}/storage_references/{referenceId} {
      allow read, list: if isAuth() && isOrgMember(orgId);
      allow create: if isAuth() && isOrgMember(orgId) && orgCreateMatch(orgId)
        && request.resource.data.organizationId == orgId;
      allow update: if isAuth() && isOrgMember(orgId)
        && resource.data.organizationId == orgId
        && request.resource.data.organizationId == orgId;
      allow delete: if isAuth() && isOrgMember(orgId)
        && resource.data.organizationId == orgId;
    }
    // RBAC-001 — memberships: prevent arbitrary privilege escalation.
    match /memberships/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid
        || isOrgMember(resource.data.organizationId)
      );
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.organizationId is string
        && (
          (
            isOrgOwner(request.resource.data.organizationId)
            && request.resource.data.roleId == 'owner'
          )
          || hasValidAcceptedInvitation(
            request.resource.data.organizationId,
            request.resource.data.roleId
          )
        );
      allow update: if isAuth() && (
        isOrgOwner(resource.data.organizationId)
        || isAdminOrAbove(resource.data.organizationId)
        || (
          resource.data.userId == request.auth.uid
          && request.resource.data.roleId == resource.data.roleId
          && request.resource.data.status == resource.data.status
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.userId == resource.data.userId
        )
        || (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.organizationId == resource.data.organizationId
          && hasValidAcceptedInvitation(resource.data.organizationId, request.resource.data.roleId)
        )
      );
      allow delete: if isAuth() && (
        isOrgOwner(resource.data.organizationId)
        || isAdminOrAbove(resource.data.organizationId)
      );
    }
    match /roles/{docId}            { allow read,write: if isAuth(); }

    // Core operational collections — tenant isolation via organizationId
    // RBAC-001: create requires membership + manager role; collaborators cannot create.
    match /releases/{docId} {
      allow read, list: if isAuth()
        && (
          isOrgOwner(resource.data.organizationId)
          || isOrgMember(resource.data.organizationId)
        );
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.organizationId is string
        && isManagerOrAbove(request.resource.data.organizationId)
        && request.resource.data.lifecycle in ['draft', 'active', 'archived', 'cancelled', 'expired']
        && request.resource.data.version == 1;
      allow update: if isAuth()
        && isManagerOrAbove(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.lifecycle in ['draft', 'active', 'archived', 'cancelled', 'expired']
        && (resource.data.version == null || request.resource.data.version is int && request.resource.data.version >= resource.data.version);
      allow delete: if isAuth()
        && isAdminOrAbove(resource.data.organizationId);
    }
    match /workflows/{docId} {
      allow read, list: if isAuth()
        && resource.data.organizationId is string
        && (isOrgOwner(resource.data.organizationId) || isOrgMember(resource.data.organizationId));
      allow create: if isAuth()
        && request.resource.data.organizationId is string
        && (isOrgOwner(request.resource.data.organizationId) || isOrgMember(request.resource.data.organizationId));
      allow update: if isAuth()
        && resource.data.organizationId is string
        && (isOrgOwner(resource.data.organizationId) || isOrgMember(resource.data.organizationId))
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isAuth()
        && resource.data.organizationId is string
        && (isOrgOwner(resource.data.organizationId) || isOrgMember(resource.data.organizationId));
    }
    match /stages/{docId}           { allow read,write: if isAuth(); }

    // Tracks — organization-scoped; role checks align with release operations.
    match /tracks/{trackId} {
      allow read, list: if resource.data.organizationId is string
        && hasOrgAccess(resource.data.organizationId);
      allow create: if request.resource.data.organizationId is string
        && request.resource.data.createdBy == request.auth.uid
        && isManagerOrAbove(request.resource.data.organizationId);
      allow update: if resource.data.organizationId is string
        && hasOrgAccess(resource.data.organizationId)
        && isManagerOrAbove(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if resource.data.organizationId is string
        && isAdminOrAbove(resource.data.organizationId);
    }

    // Release-track links derive tenant ownership from both linked entities.
    // getAfter permits createTrack's atomic track + link batch without trusting client org IDs.
    match /release_tracks/{id} {
      allow read, list: if releaseTrackCanRead();
      allow create: if releaseTrackCanWriteAfter()
        && request.resource.data.position is number;
      allow update: if releaseTrackCanRead()
        && releaseTrackCanWriteAfter()
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.releaseId == resource.data.releaseId
        && request.resource.data.trackId == resource.data.trackId
        && request.resource.data.position is number;
      allow delete: if releaseTrackCanRead();
    }

    // Track-artist credits must point to a track and an artist in the same tenant.
    match /track_artists/{id} {
      allow read, list: if trackArtistCanRead();
      allow create: if trackArtistCanWriteAfter();
      allow update: if trackArtistCanWriteExisting()
        && trackArtistCanWriteAfter()
        && request.resource.data.trackId == resource.data.trackId;
      allow delete: if trackArtistCanWriteExisting();
    }

    // Person assignments (tracks, releases, etc.)
    match /assignments/{id} {
      allow read, list: if isAuth();
      allow create: if isAuth() && request.resource.data.entityId != null;
      allow update, delete: if isAuth();
    }

    // Production deliverables
    match /production_deliverables/{id} {
      allow read, list: if isAuth();
      allow create: if isAuth() && request.resource.data.trackId != null && request.resource.data.organizationId != null;
      allow update, delete: if isAuth();
    }
    match /credits/{docId}          { allow read,write: if isAuth(); }
    match /contributors/{docId}     { allow read,write: if isAuth(); }
    // BUILD-014 domain tasks (organisationId) + legacy stage tasks
    match /tasks/{docId} {
      allow read, list: if isAuth();
      allow create: if isAuth()
        && (
          request.resource.data.organisationId is string
          || request.resource.data.stageId != null
        );
      allow update, delete: if isAuth();
    }
    match /comments/{docId}         { allow read: if isAuth(); allow create: if isAuth(); allow update,delete: if isAuth(); }
    match /deliverables/{docId}     { allow read,write: if isAuth(); }
    match /release_requirements/{docId} { allow read,write: if isAuth(); }
    match /asset_references/{docId} { allow read,write: if isAuth(); }
    match /approval_requests/{docId} { allow read,write: if isAuth(); }
    match /distribution_packages/{docId} { allow read,write: if isAuth(); }
    match /campaigns/{docId}        { allow read,write: if isAuth(); }
    match /campaign_tasks/{docId}   { allow read,write: if isAuth(); }
    match /release_artists/{docId}  { allow read,write: if isAuth(); }
    match /track_credits/{docId}    { allow read,write: if isAuth(); }
    match /rights_holders/{docId}   { allow read,write: if isAuth(); }
    match /release_ownerships/{docId} { allow read,write: if isAuth(); }
    match /track_ownerships/{docId} { allow read,write: if isAuth(); }
    match /release_budgets/{docId}  { allow read,write: if isAuth(); }
    match /cost_items/{docId}       { allow read,write: if isAuth(); }
    match /resource_assignments/{docId} { allow read,write: if isAuth(); }
    match /dependencies/{docId}     { allow read,write: if isAuth(); }
    match /operational_alerts/{docId} { allow read,write: if isAuth(); }
    match /release_milestones/{docId} {
      allow read, list: if isAuth() && orgMatch(resource.data.organizationId);
      allow create: if isAuth() && orgCreateMatch(resource.data.organizationId);
      allow update, delete: if isAuth() && orgMatch(resource.data.organizationId);
    }

    // People are organization-scoped collaborator identities.
    match /people/{docId} {
      allow read: if isAuth()
        && resource.data.organizationId is string
        && (isOrgOwner(resource.data.organizationId) || isOrgMember(resource.data.organizationId));
      allow create: if isAuth()
        && request.resource.data.organizationId is string
        && hasOrgAccessAfter(request.resource.data.organizationId);
      allow update: if isAuth()
        && resource.data.organizationId is string
        && (isOrgOwner(resource.data.organizationId) || isOrgMember(resource.data.organizationId))
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isAuth()
        && resource.data.organizationId is string
        && isAdminOrAbove(resource.data.organizationId);
    }
    match /assets/{docId} {
      allow read, list: if isAuth()
        && resource.data.organizationId is string
        && (isOrgOwner(resource.data.organizationId) || isOrgMember(resource.data.organizationId));
      allow create: if isAuth()
        && request.resource.data.organizationId is string
        && (isOrgOwner(request.resource.data.organizationId) || isOrgMember(request.resource.data.organizationId));
      allow update: if isAuth()
        && resource.data.organizationId is string
        && (isOrgOwner(resource.data.organizationId) || isOrgMember(resource.data.organizationId))
        && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isAuth()
        && resource.data.organizationId is string
        && (isOrgOwner(resource.data.organizationId) || isOrgMember(resource.data.organizationId));
    }
    // CE-UAT-001 — Invitation verification must work before the invitee signs in.
    // Possession of the unguessable token is the credential for public `get`.
    // Document id == token for CE-001 invites so unauthenticated clients use get
    // (not list). Authenticated members retain list for org invitation management.
    match /invitations/{docId} {
      allow get: if true;
      allow list: if isAuth();
      // Create/update invitations: managers+ for org; invitee may mark accepted.
      allow create: if isAuth()
        && request.resource.data.organizationId is string
        && (
          isManagerOrAbove(request.resource.data.organizationId)
          || isOrgOwner(request.resource.data.organizationId)
        );
      allow update: if isAuth() && (
        isManagerOrAbove(resource.data.organizationId)
        || (
          resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.auth.token.email is string
          && resource.data.inviteeEmail == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'updatedAt'])
        )
      );
      allow delete: if isAuth() && isAdminOrAbove(resource.data.organizationId);
    }

    // Organization-scoped audit events: readable by tenant members and immutable to clients.
    match /activity_events/{docId} {
      allow read: if isAuth()
        && resource.data.organizationId is string
        && (isOrgOwner(resource.data.organizationId) || isOrgMember(resource.data.organizationId));
      allow create: if isAuth()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.organizationId is string
        && hasOrgAccessAfter(request.resource.data.organizationId);
      allow update, delete: if false;
    }

    // User-scoped: only owner can access
    match /notifications/{docId} {
      allow read,write: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // User profiles — doc id is the Firebase auth uid (invitation accept + onboarding).
    // UAT-002: missing rules caused acceptInvitationAtomically to fail after sign-in
    // and surface as "Invalid Invitation" (transaction catch mapped to not_found).
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create, update: if isAuth() && request.auth.uid == userId;
      allow delete: if false;
    }

    // User preferences — doc id is the user id; only the owner can access.
    match /user_preferences/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // CE-005 — Assignment collaboration (tenant isolation via organizationId / assignment access)
    match /assignment_comments/{docId} {
      allow read, list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.assignmentId != null
        && request.resource.data.organizationId != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth();
      allow delete: if false; // soft-delete only
    }
    match /assignment_watchers/{docId} {
      allow read, list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.assignmentId != null
        && request.resource.data.userId != null;
      allow update: if false;
      allow delete: if isAuth();
    }
    match /assignment_comment_reads/{docId} {
      allow read, list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.assignmentId != null
        && request.resource.data.commentId != null;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
    match /notification_events/{docId} {
      allow read, list: if isAuth();
      allow create: if isAuth() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false; // immutable event log (delivery is future)
    }
    match /deliverable_links/{docId} {
      allow read, list: if isAuth();
      allow create: if isAuth() && request.resource.data.assignmentId != null;
      allow update, delete: if isAuth();
    }

    // CE-006 — Notification engine
    match /user_notifications/{docId} {
      allow read, list: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.userId != null
        && request.resource.data.eventId != null;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    match /notification_processing/{eventId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }
    match /notification_preferences/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    // NOT-002 — client enqueues pending only; Admin SDK worker updates status
    match /email_queue/{docId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.status == 'pending'
        && request.resource.data.recipientEmail != null
        && request.resource.data.notificationId != null;
      allow update, delete: if false; // Admin worker only
    }
    match /push_subscriptions/{docId} {
      allow read, list: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
    // NOT-001 — FCM push job queue (worker-owned status updates later)
    match /push_queue/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // CE-007 — Calendar preferences (user-owned)
    match /calendar_preferences/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // CE-009 — Readiness history (meaningful transitions only)
    match /release_readiness_history/{docId} {
      allow read, list: if isAuth();
      allow create: if isAuth()
        && request.resource.data.releaseId != null
        && request.resource.data.organizationId != null;
      allow update, delete: if false;
    }

    // BUILD-302A — In-app feedback (create-only for clients).
    // Tenant isolation via organizationId (mirrored organisationId on write).
    // emailDeliveryStatus starts pending; only trusted server infra may update later (BUILD-302C).
    // No client read/list/update/delete — management UI is out of scope.
    match /feedback/{docId} {
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.organizationId is string
        && request.resource.data.organizationId.size() > 0
        && isOrgMember(request.resource.data.organizationId)
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.emailDeliveryStatus == 'pending'
        && request.resource.data.context is map
        && request.resource.data.context.route is string
        && request.resource.data.context.module is string
        && request.resource.data.context.page is string;
      allow get, list: if false;
      allow update, delete: if false;
    }

  }
}
